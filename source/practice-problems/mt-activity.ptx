<worksheet xml:id="activity-mt-activity">
<title>M220 Module 5: Matrix Transformations</title>

<author>
<personnam>Dr. Anastasiia Minenkova</personnam>
</author>

<introduction>

<p>
Name: _______________________
</p>

<p>
Problem Number: _______________________
</p>

</introduction>

<subsection xml:id="learning-outcomesMT">
<title>Learning Outcomes</title>
<list>
<ul>
<li><em>MT1</em> determine if given transformation is linear,</li>
<li><em>MT2</em> find the domain and range of a matrix transformation,</li>
<li><em>MT3</em> compose matrix transformations,</li>
<li><em>MT4</em> find the standard matrix for a matrix transformation.</li>
</ul>
</list>
</subsection>

<subsection xml:id="instructionsMT">

<title>Worksheet Instructions</title>

<ol>
<li>
Find your chosen number and keep it throughout the semester.
</li>

<li>
Look at each section of the worksheet.
</li>

<li>
For each exercise group, complete the exercise matching your chosen
number.
</li>

<li>
Example: If your number is 5, complete Exercise 5 in every exercise
group.
</li>

<li>
Show your work clearly and check your answers.
</li>

<li>
Refer to the presentation instructions after completing the worksheet.
</li>
</ol>

</subsection>

<subsection xml:id="MTassignments">

<title>Assignments</title>
</subsection>
<subsection xml:id="mt1">

<title>MT1: Determine if Transformation is Linear</title>

<exercise workspace="0.6in">
<title>Problem A</title>

<statement>
<p>
Determine if transformations <m>T_{1}</m> and <m>T_{5}</m> are linear.</p>
</statement>
</exercise>

</subsection>

<subsection xml:id="mt2">

<title>MT2: Find the Domain and Range of a Matrix Transformation</title>

<exercise workspace="1in">
<title>Problem B</title>

<statement>
<p>
Find the domain and range of matrix transformations <m>T_{2}</m> and
<m>T_{3}</m>.
</p>
</statement>

</exercise>
</subsection>
<subsection xml:id="mt3">

<title>MT3: Compose Matrix Transformations</title>

<exercise workspace="2in">

<title>Problem C</title>

<statement><p>
    Compose matrix transformations <m>T_{1}</m> and <m>T_{3}</m> as
    <m>T_{1}\circ T_{3}</m> and <m>T_{3}\circ T_{1}</m>.
</p>
</statement>

</exercise>

</subsection>

<subsection xml:id="mt4">

<title>MT4: Find the Standard Matrix for a Matrix Transformation</title>

<exercise workspace="2in">

<title>Problem D</title>

<statement><p>
    find the standard matrix for matrix transformations <m>T_{1}</m>,
    <m>T_{2}</m>, <m>T_{3}</m>, and <m>T_{4}</m>.
    Which of these transformations are onto and which are one-to-one?
    Explain.
</p>

</statement>

</exercise>

</subsection>

<subsection xml:id="sec-MTtables" class="smalltext">

<table xml:id="tab-linrules">
  <title>Given transformations</title>

  <tabular>
    <col width="8%"/>
    <col width="18%"/>
    <col width="18%"/>
    <col width="18%"/>
    <col width="23%"/>
    <col width="15%"/>

    <row bottom="minor">
      <cell>#</cell>
      <cell><m>T_1\left(\begin{bmatrix}x\\y\end{bmatrix}\right)</m></cell>
      <cell><m>T_2\left(\begin{bmatrix}x\\y\\z\end{bmatrix}\right)</m></cell>
      <cell><m>T_3\left(\begin{bmatrix}x\\y\\z\end{bmatrix}\right)</m></cell>
      <cell><m>T_4\left(\begin{bmatrix}x\\y\\z\end{bmatrix}\right)</m></cell>
      <cell><m>T_5\left(\begin{bmatrix}x\\y\\z\end{bmatrix}\right)</m></cell>
    </row>

    <!-- rows 1–30 go here -->
   <row>
  <cell>1</cell>
  <cell><m>\begin{bmatrix}2x-y\\y\\x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y+z\\x+2y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y-z\end{bmatrix}</m></cell>
  <cell>Rotation by <m>30^\circ</m> about the <m>z</m>-axis</cell>
  <cell><m>\begin{bmatrix}x+z\\y-z\end{bmatrix}+\begin{bmatrix}1\\0\end{bmatrix}</m></cell>
</row>

<row>
  <cell>2</cell>
  <cell><m>\begin{bmatrix}x+y\\2x-y\\x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\y-z\\x-2y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\y\end{bmatrix}</m></cell>
  <cell>Reflection across the <m>xy</m> plane</cell>
  <cell><m>\begin{bmatrix}|x-y|\\y\end{bmatrix}</m></cell>
</row>

<row>
  <cell>3</cell>
  <cell><m>\begin{bmatrix}3x\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y+z\\x+y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y+z\end{bmatrix}</m></cell>
  <cell>Shear parallel to the <m>x</m>- and <m>z</m>-axes with the shear factor 2</cell>
  <cell><m>\begin{bmatrix}x\\y+z^2\end{bmatrix}</m></cell>
</row>

<row>
  <cell>4</cell>
  <cell><m>\begin{bmatrix}x\\x+y\\2y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}2x-y\\x+y\\3x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\z\end{bmatrix}</m></cell>
  <cell>Uniform scaling by factor <m>2</m></cell>
  <cell><m>\begin{bmatrix}x+y\\|z|\end{bmatrix}</m></cell>
</row>

<row>
  <cell>5</cell>
  <cell><m>\begin{bmatrix}2x\\y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y+z\\x+2y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y\end{bmatrix}</m></cell>
  <cell>Nonuniform scaling: <m>x</m> by <m>2</m>, <m>y</m> by <m>\tfrac12</m>, <m>z</m> unchanged</cell>
  <cell><m>\begin{bmatrix}x\\y\end{bmatrix}+\begin{bmatrix}0\\1\end{bmatrix}</m></cell>
</row>
<row>
  <cell>6</cell>
  <cell><m>\begin{bmatrix}x-y\\2y\\x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+2y\\2y+2z\\x+4y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y\end{bmatrix}</m></cell>
  <cell>Rotation by <m>90^\circ</m> about the <m>y</m>-axis</cell>
  <cell><m>\begin{bmatrix}x-z\\y+1\end{bmatrix}</m></cell>
</row>

<row>
  <cell>7</cell>
  <cell><m>\begin{bmatrix}x\\y\\x+2y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\2x-2y\\z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Reflection across the <m>xy</m>-plane</cell>
  <cell><m>\begin{bmatrix}x+z\\y+xy\end{bmatrix}</m></cell>
</row>

<row>
  <cell>8</cell>
  <cell><m>\begin{bmatrix}2x+y\\y\\x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\\x+y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y-z\end{bmatrix}</m></cell>
  <cell>Shear in the <m>z</m>-direction with factor 3 and parallel to the <m>xy</m>-plane</cell>
  <cell><m>\begin{bmatrix}x\\y-z^2\end{bmatrix}</m></cell>
</row>

<row>
  <cell>9</cell>
  <cell><m>\begin{bmatrix}x\\y\\2x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y+z\\x+2y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Rotation by <m>45^\circ</m> in the <m>xy</m>-plane</cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}+\begin{bmatrix}1\\0\end{bmatrix}</m></cell>
</row>

<row>
  <cell>10</cell>
  <cell><m>\begin{bmatrix}x+2y\\y\\x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y+z\end{bmatrix}</m></cell>
  <cell>Projection onto the <m>xz</m> plane</cell>
  <cell><m>\begin{bmatrix}x\\y+z^2\end{bmatrix}</m></cell>
</row>
<row>
  <cell>11</cell>
  <cell><m>\begin{bmatrix}x\\2y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y+z\\x+y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y\end{bmatrix}</m></cell>
  <cell>Shear in the <m>x</m>-direction with factor 2 and parallel to the <m>z</m>-plane</cell>
  <cell><m>\begin{bmatrix}x-z\\|y|\end{bmatrix}</m></cell>
</row>

<row>
  <cell>12</cell>
  <cell><m>\begin{bmatrix}3x\\y\\y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Reflection across the <m>xz</m> plane</cell>
  <cell><m>\begin{bmatrix}|x+z|\\y\end{bmatrix}</m></cell>
</row>

<row>
  <cell>13</cell>
  <cell><m>\begin{bmatrix}x-y\\y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}2x-y\\x+y\\3x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\z\end{bmatrix}</m></cell>
  <cell>Uniform stretching by factor <m>7</m></cell>
  <cell><m>\begin{bmatrix}x+y\\z+1\end{bmatrix}</m></cell>
</row>

<row>
  <cell>14</cell>
  <cell><m>\begin{bmatrix}2x\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+2y\\2y+2z\\x+4y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y\end{bmatrix}</m></cell>
  <cell>Rotation about the <m>y</m>-axis by <m>60^\circ</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y^2\end{bmatrix}</m></cell>
</row>

<row>
  <cell>15</cell>
  <cell><m>\begin{bmatrix}x\\y\\x-2y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\2x-2y\\z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Reflection across the <m>yz</m> plane</cell>
  <cell><m>\begin{bmatrix}x+z\\y+xy\end{bmatrix}</m></cell>
</row>
<row>
  <cell>11</cell>
  <cell><m>\begin{bmatrix}x\\2y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y+z\\x+y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y\end{bmatrix}</m></cell>
  <cell>Shear in the <m>x</m>-direction with factor 2 and parallel to the <m>z</m>-plane</cell>
  <cell><m>\begin{bmatrix}x-z\\|y|\end{bmatrix}</m></cell>
</row>

<row>
  <cell>12</cell>
  <cell><m>\begin{bmatrix}3x\\y\\y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Reflection across the <m>xz</m> plane</cell>
  <cell><m>\begin{bmatrix}|x+z|\\y\end{bmatrix}</m></cell>
</row>

<row>
  <cell>13</cell>
  <cell><m>\begin{bmatrix}x-y\\y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}2x-y\\x+y\\3x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\z\end{bmatrix}</m></cell>
  <cell>Uniform stretching by factor <m>7</m></cell>
  <cell><m>\begin{bmatrix}x+y\\z+1\end{bmatrix}</m></cell>
</row>

<row>
  <cell>14</cell>
  <cell><m>\begin{bmatrix}2x\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+2y\\2y+2z\\x+4y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y\end{bmatrix}</m></cell>
  <cell>Rotation about the <m>y</m>-axis by <m>60^\circ</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y^2\end{bmatrix}</m></cell>
</row>

<row>
  <cell>15</cell>
  <cell><m>\begin{bmatrix}x\\y\\x-2y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\2x-2y\\z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Reflection across the <m>yz</m> plane</cell>
  <cell><m>\begin{bmatrix}x+z\\y+xy\end{bmatrix}</m></cell>
</row>
<row>
  <cell>16</cell>
  <cell><m>\begin{bmatrix}2x+y\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\\x+y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y-z\end{bmatrix}</m></cell>
  <cell>Shear parallel to the <m>xy</m>-plane</cell>
  <cell><m>\begin{bmatrix}x\\y-z^2\end{bmatrix}</m></cell>
</row>

<row>
  <cell>17</cell>
  <cell><m>\begin{bmatrix}x\\x+y\\y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y+z\\x+2y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y\end{bmatrix}</m></cell>
  <cell>Nonuniform scaling: <m>x</m> by <m>11</m>, <m>y</m> by <m>5</m>, <m>z</m> by <m>2</m></cell>
  <cell><m>\begin{bmatrix}x\\y\end{bmatrix}+\begin{bmatrix}0\\1\end{bmatrix}</m></cell>
</row>

<row>
  <cell>18</cell>
  <cell><m>\begin{bmatrix}x-y\\2y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\y-z\\x-2y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\y\end{bmatrix}</m></cell>
  <cell>Reflection across the <m>yz</m> plane</cell>
  <cell><m>\begin{bmatrix}|x-y|\\y\end{bmatrix}</m></cell>
</row>

<row>
  <cell>19</cell>
  <cell><m>\begin{bmatrix}3x\\y\\x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y+z\\x+y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y+z\end{bmatrix}</m></cell>
  <cell>Shear parallel to the <m>xz</m>-plane with factor 5</cell>
  <cell><m>\begin{bmatrix}x\\y+z^2\end{bmatrix}</m></cell>
</row>

<row>
  <cell>20</cell>
  <cell><m>\begin{bmatrix}x\\x+y\\2y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}2x-y\\x+y\\3x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\z\end{bmatrix}</m></cell>
  <cell>Uniform scaling by factor <m>12</m></cell>
  <cell><m>\begin{bmatrix}x+y\\|z|\end{bmatrix}</m></cell>
</row>

<row>
  <cell>21</cell>
  <cell><m>\begin{bmatrix}2x\\y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y+z\\x+2y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y\end{bmatrix}</m></cell>
  <cell>Nonuniform scaling: <m>x</m> by <m>2</m>, <m>y</m> by <m>\tfrac12</m>, <m>z</m> unchanged</cell>
  <cell><m>\begin{bmatrix}x\\y\end{bmatrix}+\begin{bmatrix}1\\0\end{bmatrix}</m></cell>
</row>

<row>
  <cell>22</cell>
  <cell><m>\begin{bmatrix}x\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+2y\\2y+2z\\x+4y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y\end{bmatrix}</m></cell>
  <cell>Rotation by <m>90^\circ</m> about the <m>y</m>-axis</cell>
  <cell><m>\begin{bmatrix}x-z\\y+1\end{bmatrix}</m></cell>
</row>

<row>
  <cell>23</cell>
  <cell><m>\begin{bmatrix}x\\y\\x+2y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\2x-2y\\z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Reflection across the <m>xz</m>-plane</cell>
  <cell><m>\begin{bmatrix}x+z\\y+xy\end{bmatrix}</m></cell>
</row>

<row>
  <cell>24</cell>
  <cell><m>\begin{bmatrix}2x+y\\y\\x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\\x+y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y-z\end{bmatrix}</m></cell>
  <cell>Nonuniform scaling: <m>x</m> unchanged, <m>y</m> by <m>0.7</m>, <m>z</m> by <m>3</m></cell>
  <cell><m>\begin{bmatrix}x\\y-z^2\end{bmatrix}</m></cell>
</row>

<row>
  <cell>25</cell>
  <cell><m>\begin{bmatrix}x\\y\\2x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y+z\\x+2y+z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Rotation by <m>180^\circ</m> about the <m>z</m>-axis</cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}+\begin{bmatrix}1\\0\end{bmatrix}</m></cell>
</row>
<row>
  <cell>26</cell>
  <cell><m>\begin{bmatrix}x+y\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-y\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x\\y+z\end{bmatrix}</m></cell>
  <cell>Projection onto the <m>xz</m> plane</cell>
  <cell><m>\begin{bmatrix}x\\y+z^2\end{bmatrix}</m></cell>
</row>

<row>
  <cell>27</cell>
  <cell><m>\begin{bmatrix}x\\2y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y+z\\x+y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y\end{bmatrix}</m></cell>
  <cell>Shear parallel to the <m>yz</m>-plane with factor 5</cell>
  <cell><m>\begin{bmatrix}x-z\\|y|\end{bmatrix}</m></cell>
</row>

<row>
  <cell>28</cell>
  <cell><m>\begin{bmatrix}3x\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\y\\x+y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+z\\y\end{bmatrix}</m></cell>
  <cell>Reflection with respect to the origin</cell>
  <cell><m>\begin{bmatrix}|x+z|\\y\end{bmatrix}</m></cell>
</row>

<row>
  <cell>29</cell>
  <cell><m>\begin{bmatrix}x-y\\y\\x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}2x-y\\x+y\\3x\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+y\\z\end{bmatrix}</m></cell>
  <cell>Uniform stretching by <m>9</m></cell>
  <cell><m>\begin{bmatrix}x+y\\z+1\end{bmatrix}</m></cell>
</row>

<row>
  <cell>30</cell>
  <cell><m>\begin{bmatrix}2x\\y\\x-y\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x+2y\\2y+2z\\x+4y+2z\end{bmatrix}</m></cell>
  <cell><m>\begin{bmatrix}x-z\\y\end{bmatrix}</m></cell>
  <cell>Rotation about the <m>z</m>-axis by <m>30^\circ</m></cell>
