    -3x+3y-2z-3w=-4\\
    3x-3y+2z+w=-4\\
    x-y-z+3w=3\\
    3x-3y+3z=-4
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>12</cell>
  <cell>
    <md>
    \begin{cases}
    3x-z+3w=-6\\
