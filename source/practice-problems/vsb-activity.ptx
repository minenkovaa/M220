<table xml:id="vsb-table2">
<title>Table 2: Find a basis for an abstract vector spaces A, B, C</title>
  <tabular>
     <row bottom="minor">
      <cell>#</cell>
      <cell><m>A</m></cell>
      <cell><m>B</m></cell>
      <cell><m>C</m></cell>
    </row>
    <row>
  <cell>1</cell>
  <cell><m>\{a + (2a-b)x : a,b \in \mathbb{R}\}</m></cell>
  <cell><m>\left\{\begin{pmatrix}a&amp;0\\0&amp;b\end{pmatrix} : a,b\in\mathbb{R}\right\}</m></cell>
  <cell><m>\{(a,b,0,3a) : a,b \in \mathbb{R}\}</m></cell>
</row>

<row>
  <cell>2</cell>
  <cell><m>\{2a+ax^2 + bx^3 : a,b \in \mathbb{R}\}</m></cell>
  <cell><m>\left\{\begin{pmatrix}0&amp;a\\0&amp;b\end{pmatrix} : a,b\in\mathbb{R}\right\}</m></cell>
  <cell><m>\{(3a,a,0,b) : a,b \in \mathbb{R}\}</m></cell>
</row>

<row>
  <cell>3</cell>
  <cell><m>\{p(x)\in \mathbb{P}_3 : p(0)=0\}</m></cell>
  <cell><m>\left\{\begin{pmatrix}a&amp;b\\c&amp;0\end{pmatrix} : a,b,c\in\mathbb{R}\right\}</m></cell>
  <cell><m>\{(x_1,x_2,x_3,x_4)\in\mathbb{R}^4 : x_1=0\}</m></cell>
</row>

<row>
  <cell>4</cell>
  <cell><m>\{p(x)\in \mathbb{P}_3 : p'(0)=0\}</m></cell>
  <cell><m>\left\{\begin{pmatrix}a&amp;0\\b&amp;c\end{pmatrix} : a,b,c\in\mathbb{R}\right\}</m></cell>
  <cell><m>\{(x_1,x_2,x_3,x_4)\in\mathbb{R}^4 : x_2=0\}</m></cell>
</row>

<row>
