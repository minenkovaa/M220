<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="vsb-activity">
<title>M220 Module 7: Vector Spaces and Bases</title>

<author>
<personnam>Dr. Anastasiia Minenkova</personnam>
</author>

<introduction>

<p>
Name: _______________________
</p>

<p>
Problem Number: _______________________
</p>

</introduction>

<subsection>
<title>Learning Outcomes</title>
<list>
<dl>
      <li>
        <title>VSB1</title>

        <p>
          Determine whether a given set satisfies the
          definition of a vector space (or is a subspace).
        </p>
      </li>

      <li>
        <title>VSB2</title>

        <p>
          Find a basis for an abstract vector space.
        </p>
      </li>

      <li>
        <title>VSB3</title>

        <p>
          Translate between coordinate systems for different
          bases.
        </p>
      </li>

      <li>
        <title>VSB4</title>

        <p>
          Find a basis for the null space of a given matrix.
        </p>
      </li>

      <li>
        <title>VSB5</title>

        <p>
          Find a basis for the column space of a given
          matrix.
        </p>
      </li>
    </dl>
</list>
</subsection>

<subsection>

<title>Worksheet Instructions</title>

<ol>
<li>
Find your chosen number and keep it throughout the semester.
</li>

<li>
Look at each section of the worksheet.
</li>

<li>
For each exercise group, complete the exercise matching your chosen
number.
</li>

<li>
Example: If your number is 5, complete Exercise 5 in every exercise
group.
</li>

<li>
Show your work clearly and check your answers.
</li>

<li>
Refer to the presentation instructions after completing the worksheet.
</li>
</ol>

</subsection>

<subsection xml:id="vsbassignments">

<title>Assignments</title>
</subsection>
    <dl>
      <li>
        <title>VSB1</title>

        <p>
          Determine whether a given set (<xref ref="vsb-table1"/> parts A-D) satisfies the definition of a vector space (or is a subspace).
        </p>
      </li>

      <li>
        <title>VSB2</title>

        <p>
          Find a basis for an abstract vector space given <xref ref="vsb-table2"/>
        </p>
      </li>

      <li>
        <title>VSB3</title>

        <p>
      Find the change-of-basis matrices
      <m>\underset{\mathcal{B}\leftarrow\mathcal{C}}{P}</m>
      and
      <m>\underset{\mathcal{C}\leftarrow\mathcal{B}}{P}</m>,
      where
    </p>

    <md>
      \mathcal{B}=
      \left\{
      \begin{bmatrix}
      -2\\2\\1
      \end{bmatrix},
      \begin{bmatrix}
      -2\\1\\0
      \end{bmatrix},
      \begin{bmatrix}
      1\\0\\1
      \end{bmatrix}
      \right\}
    </md>

    <p>and</p>

    <md>
      \mathcal{C}=
      \left\{
      \begin{bmatrix}
      0\\2\\-1
      \end{bmatrix},
      \begin{bmatrix}
      -1\\1\\-1
      \end{bmatrix},
      \begin{bmatrix}
      1\\0\\1
      \end{bmatrix}
      \right\}.
    </md>
      </li>

      <li>
        <title>VSB4</title>

        <p>
          Find a basis for the null space of a given matrix from <xref ref="vsb-table3"/>.
        </p>
      </li>

      <li>
        <title>VSB5</title>

        <p>
          Find a basis for the column space of a given matrix from <xref ref="vsb-table3"/>.
        </p>
      </li>
    </dl>

