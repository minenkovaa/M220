&amp; \langle p,q\rangle = p(0)q(0)+\int_0^1 p(t)q(t)t^2\,dt\\
&amp; \langle u,v\rangle = -u^\top v\\
&amp; \langle p,q\rangle = p(0)+q(0)\\
&amp; -------------------
\end{aligned}
    </me>
  </cell>
