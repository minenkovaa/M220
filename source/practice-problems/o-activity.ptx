&amp; \langle u,v\rangle = 3u_1v_1+u_2v_2+u_3v_3+u_4v_4\\
&amp; \langle p,q\rangle = \int_0^1 p(t)q(t)e^{-t}\,dt\\
&amp; \langle u,v\rangle = 0\\
&amp; \langle p,q\rangle = p(0)^2\\
&amp; -------------------
\end{aligned}
    </me>
  </cell>
  <cell>
    <me>
\begin{bmatrix}3&amp; -1\\2&amp; 0\end{bmatrix},
\quad
\begin{bmatrix}1&amp; 3\\0&amp; -2\end{bmatrix}
    </me>
  </cell>
  <cell>
    <me>
x=\begin{bmatrix}2\\1\\0\\1\end{bmatrix},
\quad
W=\mathrm{span}\!\left\{
\begin{bmatrix}1\\0\\1\\0\end{bmatrix},
\begin{bmatrix}1\\1\\0\\1\end{bmatrix},
\begin{bmatrix}0\\1\\1\\0\end{bmatrix}
\right\}
    </me>
  </cell>
</row>

<row>
  <cell><m>20</m></cell>
  <cell>
    <me>
\begin{aligned}
&amp; \langle u,v\rangle = u_1v_1+5u_2v_2+u_3v_3+5u_4v_4\\
&amp; \langle p,q\rangle = \int_{-1}^1 p(t)q(t)e^{t^2}\,dt\\
&amp; \langle u,v\rangle = u_1v_2\\
&amp; \langle p,q\rangle = p'(0)q'(0)\\
&amp; -------------------
\end{aligned}
    </me>
  </cell>
  <cell>
    <me>
\begin{bmatrix}1&amp; 0\\2&amp; -1\end{bmatrix},
\quad
\begin{bmatrix}0&amp; 2\\1&amp; 1\end{bmatrix}
