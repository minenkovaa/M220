<row>
  <cell>19</cell>
  <cell><m>\small\left[\begin{array}{ccc}-4  &amp; -6  &amp; 7\\-7  &amp; -4  &amp; -3\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-2  &amp; 2  &amp; -6\\-3  &amp; 7  &amp; -3\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}2  &amp; 2  &amp; -4\\-4  &amp; 0  &amp; 3\\0  &amp; 1  &amp; -7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}2\\4\\-3\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-6\\5\\-1\\-6\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
    4x-7y-3z+5w=7\\
    5x+4y-z+5w=7\\
    5x-2y+z-4w=2
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>20</cell>
  <cell><m>\small\left[\begin{array}{ccc}4  &amp; 1  &amp; 7\\6  &amp; 6  &amp; -6\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}7  &amp; -3  &amp; -1\\5  &amp; -4  &amp; -6\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}2  &amp; 7  &amp; -3\\0  &amp; 4  &amp; 0\\-2  &amp; 2  &amp; -6\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}4\\-7\\-7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}2\\-6\\3\\-5\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
    6x-y-4z-w=7\\
    3x+3y+2z+2w=-7\\
    -7x-6y+5z-2w=-4
    \end{cases}
    </md>
  </cell>
</row>
<row>
  <cell>21</cell>
  <cell><m>\small\left[\begin{array}{ccc}-4  &amp; 3  &amp; 3\\-6  &amp; -7  &amp; -1\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}6  &amp; 7  &amp; -3\\-5  &amp; 6  &amp; -5\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}6  &amp; 5  &amp; 4\\-3  &amp; -5  &amp; 4\\-1  &amp; -6  &amp; -3\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}6\\-5\\5\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-1\\-1\\3\\-6\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
    -6x-3y+z-3w=-3\\
    6x+4y-5z+5w=-3\\
    4x-6y-7z+4w=2
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>22</cell>
  <cell><m>\small\left[\begin{array}{ccc}6  &amp; -6  &amp; -3\\0  &amp; -1  &amp; -5\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}7  &amp; -3  &amp; 2\\0  &amp; -4  &amp; 6\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}6  &amp; 5  &amp; 1\\-3  &amp; 6  &amp; 0\\-3  &amp; 1  &amp; -3\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}3\\-5\\0\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-3\\-5\\-4\\-2\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
    x-5y+5z+w=-4\\
    2x-2y+2z+w=-6\\
    -4x+y-z+5w=-5
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>23</cell>
  <cell><m>\small\left[\begin{array}{ccc}2  &amp; -7  &amp; -2\\4  &amp; 5  &amp; 4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-1  &amp; 2  &amp; 5\\-6  &amp; -7  &amp; -1\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-6  &amp; -1  &amp; 0\\-6  &amp; -6  &amp; -7\\-4  &amp; 6  &amp; 7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-6\\5\\-4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-3\\-4\\-6\\-5\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
    4x-3y+4z-3w=-5\\
    6x+y+3z+3w=-4\\
    -6x+2y-6z-2w=-7
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>24</cell>
  <cell><m>\small\left[\begin{array}{ccc}6  &amp; -4  &amp; -3\\-1  &amp; -2  &amp; 1\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-7  &amp; 0  &amp; 3\\-3  &amp; 0  &amp; 1\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}2  &amp; -2  &amp; -4\\-2  &amp; -5  &amp; -7\\4  &amp; -2  &amp; 4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}7\\1\\3\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}7\\-4\\6\\-4\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
    5x+5y+3z+w=2\\
    -x+4y-5z+2w=-2\\
    x-5y+4z+w=6
    \end{cases}
    </md>
  </cell>
</row>
<row>
  <cell>25</cell>
  <cell><m>\small\left[\begin{array}{ccc}5  &amp; 1  &amp; -3\\-7  &amp; -7  &amp; 2\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}2  &amp; -2  &amp; -5\\-5  &amp; -1  &amp; -7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-6  &amp; 1  &amp; -2\\3  &amp; 1  &amp; -3\\6  &amp; -2  &amp; -5\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}1\\-2\\4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}5\\4\\-6\\4\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
    x-3y-7z+3w=7\\
    -2x-y-4z+3w=-5\\
    -7x-5y+3z-6w=0
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>26</cell>
  <cell><m>\small\left[\begin{array}{ccc}-1  &amp; -1  &amp; 6\\1  &amp; 1  &amp; -1\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-2  &amp; 2  &amp; 3\\6  &amp; 7  &amp; -1\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-3  &amp; -6  &amp; 7\\-4  &amp; 5  &amp; -2\\-5  &amp; -6  &amp; -3\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}3\\-6\\7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-7\\-2\\-1\\-2\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
