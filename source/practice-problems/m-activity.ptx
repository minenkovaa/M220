  <cell><m>\small\left[\begin{array}{ccc}-3  &amp; -5  &amp; -4\\-1  &amp; 1  &amp; 1\\-5  &amp; -3  &amp; -3\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-1\\4\\-1\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-6\\6\\-2\\-7\end{array}\right]</m></cell>
  <cell>
    <md>
    \small
    \begin{cases}
    7x-4y+3z-6w=0\\
