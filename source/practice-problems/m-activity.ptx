<row>
  <cell>14</cell>
  <cell><m>\small\left[\begin{array}{ccc}-4  &amp; 1  &amp; -5\\4  &amp; 3  &amp; -7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}5  &amp; 6  &amp; -3\\4  &amp; -1  &amp; -1\end{array}\right]</m></cell>
