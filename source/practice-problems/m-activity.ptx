<row>
  <cell>18</cell>
  <cell><m>\small\left[\begin{array}{ccc}-4  &amp; 1  &amp; -5\\5  &amp; -6  &amp; -7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-7  &amp; -5  &amp; -4\\-4  &amp; -2  &amp; 2\end{array}\right]</m></cell>
