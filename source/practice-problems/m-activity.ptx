<worksheet xml:id="m-activity">
<title>M220 Module 3: Matrices</title>

<author>
<personnam>Dr. Anastasiia Minenkova</personnam>
</author>

<introduction>

<p>
Name: _______________________
</p>

<p>
Problem Number: _______________________
</p>

</introduction>

<subsection xml:id="learning-outcomesM">
<title>Learning Outcomes</title>
<list>
<ul>
<li>           M1: add matrices
</li><li>          M2: scale matrices by a real number
</li><li>          M3: perform matrix-vector multiplication
</li><li>          M4: perform matrix-matrix multiplication
</li><li>           M5: compute the transpose of a matrix
</li><li>         M6: translate a system of equations into a matrix equation of the form <m>Ax = b</m> and the vector equation form
</li>
</ul>
</list>
</subsection>

<subsection xml:id="instructionsM">

<title>Worksheet Instructions</title>

<ol>
<li>
Find your chosen number and keep it throughout the semester.
</li>

<li>
Look at each section of the worksheet.
</li>

<li>
For each exercise group, complete the exercise matching your chosen
number.
</li>

<li>
Example: If your number is 5, complete Exercise 5 in every exercise
group.
</li>

<li>
Show your work clearly and check your answers.
</li>

<li>
Refer to the presentation instructions after completing the worksheet.
</li>
</ol>

</subsection>

<subsection xml:id="massignments">

<title>Assignments</title>
</subsection>
  <exercise workspace="3in">
  <title>M1</title>
      <statement>
        <p>
        Add matrices: <m>A+B</m> and <m>A+C</m>.
                </p>
      </statement>
    </exercise>
 
    <exercise workspace="3in">
    <title>M2</title>
    

      <statement><p>
        Scale matrices by a real number: <m>5A</m>.                </p>
      </statement>
    </exercise>
  
    <exercise workspace="3in">
        <title>M3</title>
      <statement><p>
        Perform matrix-vector multiplication: <m>C\cdot u</m> and <m>C\cdot v</m>.                </p>
      </statement>
    </exercise>
 
    <exercise workspace="3in">
      <title>M4</title>
      <statement><p>
        Perform matrix-matrix multiplication: <m>A\cdot B</m>, <m>C\cdot B</m>, and <m>A\cdot C</m>.                </p>
      </statement>
    </exercise>
  
    <exercise workspace="3in">
      <title>M5</title>
      <statement><p>
        Compute the transpose of a matrix: <m>A^\top</m>, <m>C^\top</m>, and <m>v^\top</m>.
        </p>
      </statement>
    </exercise>

        <exercise workspace="3in">
      <title>M6</title>
      <statement><p>
       translate the given system of linear equations (see the last column of the table) into a matrix equation of the form <m>Ax = b</m> and the vector equation form.    </p>
      </statement>
    </exercise>

<subsection xml:id="sec-mtables" class="smalltext">
<tabular>
  <row>
