  </cell>
</row>

<row>
  <cell>28</cell>
  <cell><m>\small\left[\begin{array}{ccc}7  &amp; -2  &amp; 1\\-5  &amp; 3  &amp; 7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-2  &amp; 5  &amp; 4\\1  &amp; -7  &amp; -6\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-7  &amp; 6  &amp; -4\\4  &amp; 4  &amp; 7\\-7  &amp; 0  &amp; -4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}3\\1\\5\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}0\\0\\3\\4\end{array}\right]</m></cell>
  <cell>
    <md>
