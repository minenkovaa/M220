<row>
  <cell>1</cell>
  <cell><m>\small\left[\begin{array}{ccc}-1   &amp;  -1   &amp;  -4\\2   &amp;  -5   &amp;  -4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-4   &amp;  -5   &amp;  5\\-6   &amp;  -3   &amp;  4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-1   &amp;  1   &amp;  3\\4   &amp;  1   &amp;  -6\\2   &amp;  0   &amp;  -4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-1\\4\\2\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}2\\-4\\5\\7\end{array}\right]</m></cell>
  <cell>
    <md>\small
    \begin{cases}
    5x-2y+6z-w=6\\
    3x-4y-5z+3w=-5\\
    6x+2y-2z-6w=4
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>2</cell>
  <cell><m>\small\left[\begin{array}{ccc}1   &amp;  3   &amp;  5\\-6   &amp;  0   &amp;  -2\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-1   &amp;  -7   &amp;  -3\\1   &amp;  -7   &amp;  -1\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-4   &amp;  -2   &amp;  7\\1   &amp;  -6   &amp;  0\\1   &amp;  7   &amp;  -4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}2\\0\\-7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-2\\-5\\-4\\7\end{array}\right]</m></cell>
  <cell>
    <md>\small
    \begin{cases}
    4x-5y+4z+5w=0\\
    2x+7y-5z+w=3\\
    -5x-7y-6z-7w=-5
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>3</cell>
  <cell><m>\small\left[\begin{array}{ccc}0   &amp;  3   &amp;  6\\-1   &amp;  -6   &amp;  7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-1   &amp;  3   &amp;  -6\\-5   &amp;  -3   &amp;  2\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-7   &amp;  -1   &amp;  -2\\-5   &amp;  1   &amp;  -1\\-4   &amp;  7   &amp;  5\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-7\\3\\-4\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}0\\-3\\1\\-1\end{array}\right]</m></cell>
  <cell>
    <md>\small
    \begin{cases}
    6x+5y-5z-2w=4\\
    7x-7y-5z+4w=6\\
    4x+2y+5z+4w=-5
    \end{cases}
    </md>
  </cell>
</row>

<row>
  <cell>4</cell>
  <cell><m>\small\left[\begin{array}{ccc}2   &amp;  -1   &amp;  -6\\-6   &amp;  -6   &amp;  -5\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-3   &amp;  -5   &amp;  -5\\-1   &amp;  -5   &amp;  7\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{ccc}-4   &amp;  7   &amp;  1\\-2   &amp;  5   &amp;  0\\5   &amp;  -4   &amp;  6\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}-3\\-6\\6\end{array}\right]</m></cell>
  <cell><m>\small\left[\begin{array}{c}6\\-2\\-5\\3\end{array}\right]</m></cell>
  <cell>
    <md>\small
